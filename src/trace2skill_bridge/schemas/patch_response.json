{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "when", "new_conditions", "judgments", "edits", "reason"],
  "properties": {
    "scope": {"$ref": "applicability_expression.json"},
    "when": {"$ref": "applicability_expression.json"},
    "new_conditions": {"type": "array", "items": {"$ref": "condition_registry.json#/properties/conditions/items"}},
    "judgments": {"type": "array", "items": {"$ref": "condition_response.json#/properties/judgments/items"}},
    "edits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "old_text", "new_text"],
        "properties": {"file": {"type": "string", "minLength": 1}, "old_text": {"type": "string"}, "new_text": {"type": "string"}}
      }
    },
    "reason": {"type": "string", "minLength": 1}
  }
}
