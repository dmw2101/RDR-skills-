{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Condition registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "conditions"],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "definition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "examples": {"$ref": "#/$defs/strings"},
        "counterexamples": {"$ref": "#/$defs/strings"},
        "typed_predicate": {
          "type": "object", "additionalProperties": false, "required": ["field", "op", "value"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "op": {"enum": ["eq", "in", "contains"]},
            "value": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/strings"}]}
          },
          "allOf": [{"if": {"properties": {"op": {"const": "in"}}},
                     "then": {"properties": {"value": {"type": "array", "minItems": 1}}},
                     "else": {"properties": {"value": {"type": "string"}}}}]
        }
      }
    }}
  },
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
