# Compiled skill bundles store SHA-256 hashes of these exact bytes. Keep LF
# endings on every platform so checkouts with core.autocrlf still load.
skills/**/initial.md text eol=lf
skills/**/compiled/*.json text eol=lf
skills/variants/**/gemini-dependencies.json text eol=lf
# Candidate provenance checks compare exact source bytes on Windows and Linux.
skills/sopbench_*/** text eol=lf
skills/tau_banking/** text eol=lf
skills/cobol_gl_reconciliation/** text eol=lf
skills/telecom/** text eol=lf
