{
  "version": 1,
  "model": {
    "factory": "skill_agent.models:OpenAICompatibleClient",
    "options": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "api_key_env": "MODEL_API_KEY",
      "temperature": 0,
      "max_tokens": 8192,
      "timeout": 90,
      "provider": {
        "only": ["inference-net"],
        "allow_fallbacks": false,
        "require_parameters": true,
        "max_price": {"prompt": 0.08, "completion": 0.50}
      }
    }
  },
  "benchmark": {
    "factory": "skill_agent.benchmarks.varex:VarexAdapter",
    "options": {"data_dir": "benchmarks/local-data/varex-dev-30"}
  },
  "skill": {
    "id": "pdf",
    "full_markdown": "skills/pdf/initial.md",
    "receipt": "experiments/pdf-snapshot-mcrdr.json",
    "resolver": {
      "factory": "skill_agent.resolvers:HttpSkillResolver",
      "options": {"base_url": "http://127.0.0.1:8765", "timeout": 30}
    }
  },
  "run": {
    "skill_loading": "rolling",
    "output_dir": "experiments/mcrdr-deepseek-dev30",
    "split": "dev",
    "limit": 30,
    "replicates": 1,
    "concurrency": 1,
    "max_calls": 20,
    "timeout_seconds": 600
  }
}
