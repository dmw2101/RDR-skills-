{
  "version": 1,
  "name": "varex-pdf-mcrdr",
  "collect_run": "experiments/mcrdr-varex-pilot",
  "skill_dir": "skills/pdf",
  "condition": "reduced",
  "output_dir": "experiments/learning/varex-pdf-mcrdr",
  "hooks": {"factory": "trace_learner.benchmarks.varex:VarexHooks"},
  "cornerstones_per_episode": 6,
  "verifier": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "qwen/qwen3.7-plus",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 8192,
        "timeout": 180,
        "provider": {
          "only": ["alibaba"],
          "allow_fallbacks": false,
          "require_parameters": true,
          "max_price": {"prompt": 0.40, "completion": 1.60}
        }
      }
    },
    "max_calls": 30,
    "timeout_seconds": 900,
    "concurrency": 1
  },
  "judge": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "qwen/qwen3.7-flash",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout": 120,
        "provider": {
          "only": ["alibaba"],
          "allow_fallbacks": false,
          "require_parameters": true,
          "max_price": {"prompt": 0.23, "completion": 0.92}
        }
      }
    }
  },
  "merge": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "qwen/qwen3.7-plus",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 8192,
        "timeout": 180,
        "provider": {
          "only": ["alibaba"],
          "allow_fallbacks": false,
          "require_parameters": true,
          "max_price": {"prompt": 0.40, "completion": 1.60}
        }
      }
    }
  },
  "validation": {
    "enabled": true,
    "service_url": "http://127.0.0.1:8765",
    "store": "experiments/snapshots",
    "replicates": 2,
    "protected_limit": 3,
    "max_calls": 20,
    "timeout_seconds": 600
  }
