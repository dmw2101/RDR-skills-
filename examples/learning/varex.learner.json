{
  "version": 1,
  "name": "varex-pdf-mcrdr",
  "collect_run": "experiments/mcrdr-varex-pilot",
  "skill_dir": "skills/pdf",
  "condition": "reduced",
  "output_dir": "experiments/learning/varex-pdf-mcrdr",
  "hooks": {"factory": "trace_learner.benchmarks.varex:VarexHooks"},
  "cornerstones_per_episode": 6,
  "verifier": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://YOUR-PROVIDER/v1",
        "model": "YOUR-STRONG-TOOL-CALLING-MODEL",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout": 180
      }
    },
    "max_calls": 30,
    "timeout_seconds": 900,
    "concurrency": 1
  },
  "judge": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://YOUR-PROVIDER/v1",
        "model": "YOUR-TOOL-CALLING-MODEL",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 512,
        "timeout": 60
      }
    }
  },
  "merge": {
    "model": {
      "factory": "skill_agent.models:OpenAICompatibleClient",
      "options": {
        "base_url": "https://YOUR-PROVIDER/v1",
        "model": "YOUR-STRONG-TOOL-CALLING-MODEL",
        "api_key_env": "MODEL_API_KEY",
        "temperature": 0,
        "max_tokens": 4096,
        "timeout": 180
      }
    }
  },
  "validation": {
    "enabled": true,
    "service_url": "http://127.0.0.1:8765",
    "store": "experiments/snapshots",
    "replicates": 2,
    "protected_limit": 3,
    "max_calls": 20,
    "timeout_seconds": 600
  }
}
